// WiFi/OTA credentials + band selection for rfenv_continuous.ino --
// GITIGNORED, never commit real values here. Fill in the placeholders
// below before flashing.

// ==== Band select ====
// Both physical scanner units (one EU868, one 70cm -- different
// antenna/RF matching network each, same ESP32 board otherwise) share
// this one .ino. Pick which unit THIS build/flash is for by setting
// ACTIVE_BAND -- same idea as ttn-heltec's own ACTIVE_DEVICE (see that
// project's secrets.h.example for the same pattern). Unlike ttn-heltec's
// V3/V4 board revision, this can't be auto-detected from a compiler
// macro -- there's no hardware signal indicating which antenna is
// physically attached, the ESP32 board itself is identical either way --
// so this genuinely has to be told, not detected.
#define BAND_EU868 1
#define BAND_70CM  2
#define ACTIVE_BAND BAND_EU868

// ==== WiFi / OTA / web dashboard (all optional) ====
// WIFI_SSID / WIFI_PASSWORD: your WiFi network. If left as the
// placeholders (or WIFI_SSID is empty), the sketch skips WiFi entirely
// and runs OLED-button-only -- WiFi is best-effort, never required. This
// only matters if you want the standalone web dashboard (e.g. using this
// board as a portable scanner checked from a phone/laptop).
//
// OTA_PASSWORD: required to actually flash over WiFi via ArduinoOTA --
// pick something real, not the placeholder. An unauthenticated OTA
// listener is a bad idea, so ArduinoOTA.begin() still runs if WiFi
// connects even with the placeholder password, but you should change
// it before relying on OTA for anything.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define OTA_PASSWORD "YOUR_OTA_PASSWORD"

// Password for the web dashboard's login modal (see WEB_PASSWORD in the
// .ino). Kept as its own #define, separate from OTA_PASSWORD, so you can
// give the web UI a different password later without touching OTA -- set
// to the same value here as a starting point only.
#define WEB_PASSWORD "YOUR_WEB_PASSWORD"
