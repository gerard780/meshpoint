#ifndef TTN_HELTEC_SECRETS_H
#define TTN_HELTEC_SECRETS_H

// Copy this file to secrets.h and fill in your own TTN OTAA credentials.
// secrets.h is gitignored - it will not be committed.

// ==================== Device selection ====================
// One secrets.h now holds every physical unit's credentials at once, each
// in its own named block below - add one DEVICE_* line and one #elif block
// per unit, then pick which one THIS build/flash is for by setting
// ACTIVE_DEVICE. Only the active device's block actually gets compiled in
// (the others are dead #if branches, discarded before compilation even
// starts) - a runtime table instead would bake every unit's real keys into
// every flashed binary, which is worse if any single unit is ever lost or
// compromised: this way each binary only ever contains its own device's
// secrets, same as when every device had its own separate secrets.h file.
#define DEVICE_V3 1
#define DEVICE_V4 2
// #define DEVICE_YOURS 3   // add more like this, then extend the #elif
//                          // chain below with a matching block

#define ACTIVE_DEVICE DEVICE_V3

#if ACTIVE_DEVICE == DEVICE_V3
  // Used for this unit's mDNS/OTA hostname (ttn-heltec-<name>.local) and
  // the web UI's title - must be unique among any units on the same
  // network, or mDNS/AP names collide and you can't tell them apart.
  #define SECRET_DEVICE_NAME "v3"

  #define SECRET_JOIN_EUI 0x0000000000000000
  #define SECRET_DEV_EUI  0x0000000000000000

  // Paste straight from the TTN console's key field - 32 hex chars. Spaces/
  // dashes in between are fine too, they get stripped when the .ino parses
  // this into the byte array RadioLib actually wants.
  #define SECRET_APP_KEY "00000000000000000000000000000000"
  // Only needed for LoRaWAN 1.1 devices (separate AppKey/NwkKey in TTN
  // console). For 1.0.x devices, set this to the same string as SECRET_APP_KEY.
  #define SECRET_NWK_KEY "00000000000000000000000000000000"

#elif ACTIVE_DEVICE == DEVICE_V4
  #define SECRET_DEVICE_NAME "v4"

  #define SECRET_JOIN_EUI 0x0000000000000000
  #define SECRET_DEV_EUI  0x0000000000000000
  #define SECRET_APP_KEY "00000000000000000000000000000000"
  #define SECRET_NWK_KEY "00000000000000000000000000000000"

#endif

// ==================== Shared across every device ====================
// Same WiFi network and status-page/OTA password for the whole fleet - no
// real reason for these to differ per unit, and keeping them shared means
// changing your WiFi password once here instead of in every device's block.
// Only used when running on USB, see detectUsbPower() in the .ino.
#define SECRET_WIFI_SSID     "your-wifi-ssid"
#define SECRET_WIFI_PASSWORD "your-wifi-password"

// Fallback access point, started only if the WiFi STA connect above fails.
// The .ino appends this unit's own SECRET_DEVICE_NAME to this base SSID at
// runtime (see wifiSetup()'s apSsid), so two units falling back to AP mode
// at the same time never show up as identical, indistinguishable networks -
// this is just the shared prefix, not the full SSID.
#define SECRET_AP_SSID     "ttn-heltec-setup"
#define SECRET_AP_PASSWORD "changeme123"

// Status page / OTA login password
#define SECRET_WEB_PASSWORD "changeme123"

#endif
