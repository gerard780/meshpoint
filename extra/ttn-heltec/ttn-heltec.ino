}

static void handleLoginPost()
{
  String submitted = server.arg("password");
  bool match = submitted == SECRET_WEB_PASSWORD;
  Serial.printf("Login attempt: received='%s' expected='%s' -> %s\n",
                submitted.c_str(), SECRET_WEB_PASSWORD, match ? "MATCH" : "NO MATCH");
  if (match) {
    sessionToken = randomToken();
    Serial.println("Login OK, issuing session=" + sessionToken);
    server.sendHeader("Set-Cookie", "session=" + sessionToken + "; Path=/; HttpOnly");
    server.sendHeader("Location", "/");
    server.send(302);
  } else {
    server.sendHeader("Location", "/login?error=1");
    server.send(302);
  }
}

static void handleLogout()
{
  sessionToken = "";
  server.sendHeader("Location", "/login");
  server.send(302);
}

static void handleSend()
{
  if (!isAuthed()) {
    server.sendHeader("Location", "/login");
    server.send(302);
    return;
  }
  manualSendRequested = true;
  server.sendHeader("Location", "/");
  server.send(302);
}

